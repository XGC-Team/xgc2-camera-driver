{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xgc2-camera-v4l2",
      "version": "1.1.0",
      "label": "XGC2 camera (V4L2)",
      "description": "One camera node for a V4L2 MJPEG device. It publishes the camera contract on ROS (image_raw/compressed, camera_info, frame_timing, latched stream_info) and serves the media-edge camera-source service: ready means the device is open and has delivered a picture, H.264/RTP is encoded only while media-edge holds a lease, and the 1080p preview only while its topic has subscribers. The node keeps waiting for an unplugged camera.",
      "parameters": {
        "properties": {
          "nodeName": {
            "type": "string",
            "description": "ROS node name.",
            "default": "camera"
          },
          "cameraNamespace": {
            "type": "string",
            "description": "ROS namespace; the camera topics live below it.",
            "default": "/usb_cam"
          },
          "cameraName": {
            "type": "string",
            "description": "Stable camera name (stream id and calibration partition).",
            "default": "usb_cam"
          },
          "frameId": {
            "type": "string",
            "description": "Optical frame of the published images.",
            "default": "usb_cam_optical_frame"
          },
          "controlSocket": {
            "type": "string",
            "description": "camera-source service socket, created by the supervisor inside its private runtime directory.",
            "default": "",
            "fixedOnly": true
          },
          "sourceId": {
            "type": "string",
            "description": "Source id media-edge uses for this camera in its source roster.",
            "default": "camera"
          },
          "rtpHost": {
            "type": "string",
            "description": "Loopback destination of the H.264/RTP stream; must equal media-edge's RTP listener host.",
            "default": "127.0.0.1"
          },
          "rtpPort": {
            "type": "integer",
            "description": "Destination port of the H.264/RTP stream; must equal media-edge's RTP listener port.",
            "default": 5004,
            "minimum": 1,
            "maximum": 65535
          },
          "h264Encoder": {
            "type": "string",
            "description": "h264_nvenc prefers the NVIDIA hardware encoder and falls back to libx264 when it cannot be opened; libx264 never tries the hardware.",
            "default": "h264_nvenc",
            "enum": [
              "h264_nvenc",
              "libx264"
            ]
          },
          "h264Bitrate": {
            "type": "integer",
            "description": "Target bit rate of the RTP stream in bits per second; the ceiling in quality mode.",
            "default": 25000000,
            "minimum": 100000,
            "maximum": 1000000000
          },
          "h264Preset": {
            "type": "string",
            "description": "libx264 preset; empty selects veryfast.",
            "default": ""
          },
          "h264GopSeconds": {
            "type": "number",
            "description": "Seconds between IDR pictures of a live stream; a requested keyframe is always an IDR.",
            "default": 1.0,
            "minimum": 0.1,
            "maximum": 60.0
          },
          "h264RateControl": {
            "type": "string",
            "description": "bitrate: target bit rate; quality: constant quality with the bit rate as ceiling; auto: quality for a still, bitrate otherwise.",
            "default": "auto",
            "enum": [
              "auto",
              "bitrate",
              "quality"
            ]
          },
          "h264Quality": {
            "type": "integer",
            "description": "CRF (libx264) or CQ (NVENC) in quality mode; lower is better.",
            "default": 23,
            "minimum": 0,
            "maximum": 51
          },
          "previewEnabled": {
            "type": "boolean",
            "description": "Publish the 1080p H.264 preview topic while it has subscribers.",
            "default": true
          },
          "previewTopic": {
            "type": "string",
            "description": "Preview topic below the camera namespace.",
            "default": "video_h264"
          },
          "previewMaxWidth": {
            "type": "integer",
            "description": "Largest preview width; the picture is never enlarged.",
            "default": 1920,
            "minimum": 16,
            "maximum": 16384
          },
          "previewMaxHeight": {
            "type": "integer",
            "description": "Largest preview height; the picture is never enlarged.",
            "default": 1080,
            "minimum": 16,
            "maximum": 16384
          },
          "previewBitrate": {
            "type": "integer",
            "description": "Preview bit rate in bits per second.",
            "default": 8000000,
            "minimum": 100000,
            "maximum": 1000000000
          },
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311",
            "output": true
          },
          "rosIp": {
            "type": "string",
            "default": "",
            "output": true
          },
          "rosHostname": {
            "type": "string",
            "default": "",
            "output": true
          },
          "rosLogDir": {
            "type": "string",
            "default": "/var/lib/xgc2/ros/log/camera"
          },
          "videoDevice": {
            "type": "string",
            "description": "Stable by-id V4L2 path; the node retains it and waits while the camera is unplugged.",
            "default": "/dev/v4l/by-id/usb-LRCP_imx415_LRCP_imx415_01.00.00-video-index0"
          },
          "width": {
            "type": "integer",
            "default": 3840,
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "default": 2160,
            "minimum": 1,
            "maximum": 16384
          },
          "framerate": {
            "type": "number",
            "default": 30.0,
            "minimum": 0.1,
            "maximum": 1000.0
          },
          "pixelFormat": {
            "type": "string",
            "description": "The media outputs need mjpeg.",
            "default": "mjpeg",
            "enum": [
              "mjpeg",
              "yuyv",
              "uyvy",
              "rgb24",
              "bgr24",
              "nv12",
              "grey"
            ]
          },
          "captureMode": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "single-plane",
              "multi-plane"
            ]
          },
          "bufferCount": {
            "type": "integer",
            "default": 4,
            "minimum": 2,
            "maximum": 32
          },
          "captureTimeoutMs": {
            "type": "integer",
            "default": 2000,
            "minimum": 1,
            "maximum": 60000
          },
          "unknownTimestampClock": {
            "type": "string",
            "default": "assume_monotonic",
            "enum": [
              "reject",
              "assume_monotonic",
              "assume_realtime"
            ]
          },
          "rawPublishMode": {
            "type": "string",
            "description": "Decode and publish sensor_msgs/Image: never, only while subscribed, or always.",
            "default": "never",
            "enum": [
              "never",
              "on_demand",
              "always"
            ]
          },
          "publishEncoded": {
            "type": "boolean",
            "description": "Publish the camera JPEG as image_raw/compressed.",
            "default": true
          },
          "outputEncoding": {
            "type": "string",
            "default": "bgr8",
            "enum": [
              "bgr8",
              "rgb8",
              "mono8"
            ]
          },
          "cameraInfoFile": {
            "type": "string",
            "description": "Timestamped intrinsics under <root>/phy/<cameraName>/; empty publishes the uncalibrated default.",
            "default": "",
            "x-xgc-path-kind": "file",
            "x-xgc-file-extensions": [
              ".yaml",
              ".yml"
            ]
          }
        },
        "groups": [
          {
            "id": "media",
            "label": "H.264 media",
            "collapsed": true,
            "parameters": [
              "rtpHost",
              "rtpPort",
              "h264Encoder",
              "h264Bitrate",
              "h264Preset",
              "h264GopSeconds",
              "h264RateControl",
              "h264Quality",
              "previewEnabled",
              "previewTopic",
              "previewMaxWidth",
              "previewMaxHeight",
              "previewBitrate"
            ]
          },
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosMasterUri",
              "rosIp",
              "rosHostname",
              "rosLogDir"
            ]
          }
        ]
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc2_camera_driver/xgc2_camera_driver_node",
        "args": [
          "__name:=${nodeName}",
          "__ns:=${cameraNamespace}",
          "_source_kind:=v4l2",
          "_camera_name:=${cameraName}",
          "_frame_id:=${frameId}",
          "_video_device:=${videoDevice}",
          "_width:=${width}",
          "_height:=${height}",
          "_framerate:=${framerate}",
          "_pixel_format:=${pixelFormat}",
          "_capture_mode:=${captureMode}",
          "_buffer_count:=${bufferCount}",
          "_capture_timeout_ms:=${captureTimeoutMs}",
          "_unknown_timestamp_clock:=${unknownTimestampClock}",
          "_raw_publish_mode:=${rawPublishMode}",
          "_publish_encoded:=${publishEncoded}",
          "_output_encoding:=${outputEncoding}",
          "_camera_info_file:=${cameraInfoFile}",
          "_control_socket:=${controlSocket}",
          "_source_id:=${sourceId}",
          "_rtp_host:=${rtpHost}",
          "_rtp_port:=${rtpPort}",
          "_h264_encoder:=${h264Encoder}",
          "_h264_bitrate:=${h264Bitrate}",
          "_h264_preset:=${h264Preset}",
          "_h264_gop_seconds:=${h264GopSeconds}",
          "_h264_rate_control:=${h264RateControl}",
          "_h264_quality:=${h264Quality}",
          "_preview_enabled:=${previewEnabled}",
          "_preview_topic:=${previewTopic}",
          "_preview_max_width:=${previewMaxWidth}",
          "_preview_max_height:=${previewMaxHeight}",
          "_preview_bitrate:=${previewBitrate}"
        ],
        "env": {
          "ROS_MASTER_URI": "${rosMasterUri}",
          "ROS_IP": "${rosIp}",
          "ROS_HOSTNAME": "${rosHostname}",
          "ROS_LOG_DIR": "${rosLogDir}",
          "ROS_DISTRO": "noetic",
          "ROS_VERSION": "1",
          "ROS_ROOT": "/opt/ros/noetic/share/ros",
          "ROS_PACKAGE_PATH": "/opt/ros/noetic/share",
          "LD_LIBRARY_PATH": "/opt/ros/noetic/lib:/opt/ros/noetic/lib/x86_64-linux-gnu:/opt/ros/noetic/lib/aarch64-linux-gnu",
          "PATH": "/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        }
      },
      "readiness": {
        "kind": "describe",
        "startGraceMs": 15000,
        "timeoutMs": 30000
      },
      "stop": {
        "graceMs": 5000
      },
      "services": [
        {
          "service": "camera-source",
          "api_version": "v1",
          "profile": "http.v1",
          "endpointParameter": "controlSocket"
        }
      ]
    }
  ]
}
